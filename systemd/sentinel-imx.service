[Unit]
Description=Sentinel i.MX log-anomaly detection daemon
Documentation=https://example.invalid/sentinel-imx-sys
After=dbus.service systemd-journald.service
Wants=dbus.service

[Service]
Type=simple
ExecStart=/usr/bin/sentinel-imxd --config /etc/sentinel-imx/sentinel-imx.conf
Restart=on-failure
RestartSec=5

# Target the NPU (not the 3D GPU) when using the Vivante VX delegate.
Environment=USE_GPU_INFERENCE=0

# The daemon reads the systemd journal and the system bus, and writes its
# capture file.
StateDirectory=sentinel-imx
ReadWritePaths=/var/lib/sentinel-imx

# Hardening. Ingest is via journald (kernel + userspace) and the system bus;
# keep the surface small.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=false
# Read access to the journal (kernel + userspace log ingest).
SupplementaryGroups=systemd-journal
ReadOnlyPaths=-/var/log/journal -/run/log/journal
# Naming any DeviceAllow switches systemd to a device allow-list (only the
# listed nodes + systemd's small default set are reachable), so every device we
# use must be listed explicitly:
#   - /dev/galcore: Vivante NPU/GPU delegate
DeviceAllow=/dev/galcore rw

[Install]
WantedBy=multi-user.target
